[    0s] seeds: {'arcgis_roots': 0, 'arcgis_services': 0, 'wms': 0, 'wfs': 0, 'wmts': 0, 'wcs': 0, 'hub': 0, 'ckan': 0, 'agol': 0, 'gn': 0, 'records': [{'kind': 'record', 'id': 'gebco-2026-grid-opendap', 'title': 'GEBCO_2026 Grid: global elevation and water depth, 15 arc-second (OPeNDAP)', 'publisher': 'GEBCO (IHO-IOC); distributed by NERC CEDA for BODC', 'abstract': "GEBCO's global terrain model for ocean and land: elevation in metres on a 15 arc-second grid (about 460 m at the equator), negative below sea level. The 2026 release, published 23 April 2026, built on SRTM15+ v2.8 with the Seabed 2030 regional grids. This is GEBCO's own distribution, through CEDA; OPeNDAP returns a single cell, so one depth costs one small request (slow: 6-8 seconds when checked). Most ocean cells are interpolated rather than measured: the GEBCO_2026 TID grid says which. Not for navigation.", 'endpoints': [{'protocol': 'opendap', 'url': 'https://dap.ceda.ac.uk/thredds/dodsC/bodc/gebco/global/gebco_2026/ice_surface_elevation/netcdf/GEBCO_2026.nc', 'service_url': 'https://dap.ceda.ac.uk/thredds/dodsC/bodc/gebco/global/gebco_2026/ice_surface_elevation/netcdf/GEBCO_2026.nc.dds', 'format': 'netCDF (OPeNDAP)', 'capabilities': ['download', 'sample'], 'info': {'bands': 1, 'pixel_type': 'S16', 'data_type': 'elevation', 'sample': {'method': 'opendap', 'variable': 'elevation', 'value': 'elevation', 'units': 'm', 'vertical_datum': 'mean sea level (CF standard name height_above_mean_sea_level)', 'origin': [-180, -90], 'cell_deg': 0.004166666666666667, 'rows': 43200, 'cols': 86400, 'row': 'floor((lat + 90) * 240)', 'col': 'floor((lon + 180) * 240)', 'sample_url': '{url}.ascii?elevation[{row}:1:{row}][{col}:1:{col}]', 'note': "Negative below sea level. Checked 19 Nov 2026: central North Sea (57.9N 1.9E) -86 m; off the Niger Delta (4.0N 5.5E) -83 m. The answer is text: the value follows the line 'elevation.elevation[1][1]'."}}}, {'protocol': 'download', 'url': 'https://dap.ceda.ac.uk/bodc/gebco/global/gebco_2026/ice_surface_elevation/netcdf/GEBCO_2026.nc', 'format': 'netCDF (7.5 GB)'}], 'landing_page': 'https://www.gebco.net/data-products/gridded-bathymetry-data', 'licence': 'Public domain, attribution required (GEBCO terms of use)', 'bbox': [-180, -90, 180, 90], 'detail_m': 460, 'geometry_type': 'raster', 'concepts_hint': ['bathymetry', 'elevation', 'seabed depth'], '_ctx': {'publisher': 'GEBCO (IHO-IOC); distributed by NERC CEDA for BODC', 'publisher_type': 'international', 'country': '', 'seed_catalog': 'curated:values.yaml', 'discovered_via': 'curated'}}, {'kind': 'record', 'id': 'gebco-2026-grid-unh-imageserver', 'title': 'GEBCO_2026 Grid: global elevation and water depth, 15 arc-second (ArcGIS image service, UNH CCOM)', 'publisher': 'GEBCO grid, served by the University of New Hampshire Center for Coastal and Ocean Mapping', 'publisher_type': 'academic', 'abstract': "The same GEBCO_2026 grid served as an ArcGIS image service by UNH's Center for Coastal and Ocean Mapping: identify or getSamples returns the elevation in metres at a point, negative below sea level, in well under a second. Raw grid values, no vertical exaggeration (the 5x service in the same folder is left out). Not GEBCO's own distribution: use the OPeNDAP record when provenance matters, this one when speed does. Not for navigation.", 'endpoints': [{'protocol': 'arcgis-imageserver', 'url': 'https://gis.ccom.unh.edu/server/rest/services/GEBCO2026/gebco_2026_IS/ImageServer', 'check_url': 'https://gis.ccom.unh.edu/server/rest/services/GEBCO2026/gebco_2026_IS/ImageServer?f=json', 'capabilities': ['render', 'sample'], 'info': {'bands': 1, 'pixel_type': 'S16', 'data_type': 'elevation', 'sample': {'method': 'identify', 'value': 'elevation', 'units': 'm', 'vertical_datum': 'mean sea level (GEBCO grid)', 'note': "Checked 19 Nov 2026: central North Sea -86 m, matching GEBCO's own file; 4.0N 5.5E -87 m (a cell edge; OPeNDAP's cell there gives -83 m)."}}}], 'landing_page': 'https://www.gebco.net/data-products/gridded-bathymetry-data', 'licence': 'Public domain, attribution required (GEBCO terms of use)', 'bbox': [-180, -90, 180, 90], 'detail_m': 460, 'geometry_type': 'raster', 'concepts_hint': ['bathymetry', 'elevation', 'seabed depth'], '_ctx': {'publisher': 'GEBCO grid, served by the University of New Hampshire Center for Coastal and Ocean Mapping', 'publisher_type': 'academic', 'country': '', 'seed_catalog': 'curated:values.yaml', 'discovered_via': 'curated'}}, {'kind': 'record', 'id': 'gebco-2026-tid-unh-imageserver', 'title': 'GEBCO_2026 Type Identifier (TID) grid: measured or interpolated depth (ArcGIS image service, UNH CCOM)', 'publisher': 'GEBCO grid, served by the University of New Hampshire Center for Coastal and Ocean Mapping', 'publisher_type': 'academic', 'abstract': "For each GEBCO_2026 cell, a code for what the depth is based on, so a depth can be reported with its footing. Per GEBCO's TID table: 0 land; 10-17 direct measurements (for example 10 singlebeam, 11 multibeam, 17 a combination); 40-46 indirect, such as predicted from satellite gravity or interpolated; 70-72 pre-generated grids, unknown sources and steering points. Check the code table on gebco.net before relying on a specific code.", 'endpoints': [{'protocol': 'arcgis-imageserver', 'url': 'https://gis.ccom.unh.edu/server/rest/services/GEBCO2026/gebco_2026_tid_IS/ImageServer', 'check_url': 'https://gis.ccom.unh.edu/server/rest/services/GEBCO2026/gebco_2026_tid_IS/ImageServer?f=json', 'capabilities': ['render', 'sample'], 'info': {'bands': 1, 'data_type': 'thematic', 'sample': {'method': 'identify', 'value': 'class', 'note': 'TID code. Checked 19 Nov 2026: central North Sea 17 (combination of direct measurements).'}}}], 'landing_page': 'https://www.gebco.net/data-products/gridded-bathymetry-data', 'licence': 'Public domain, attribution required (GEBCO terms of use)', 'bbox': [-180, -90, 180, 90], 'detail_m': 460, 'geometry_type': 'raster', 'concepts_hint': ['bathymetry', 'data quality', 'so