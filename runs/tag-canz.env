# Haiku tagging for Canada, Australia, NZ (passing datasets, already-tagged skipped)
SOURCE=canz
ONLY_PASSING=1
# resume: these batches finished but collection crashed on one malformed answer
BATCH_ID=
# 24 Nov: re-tag after the contamination vocabulary split (contaminated-land, landfill, pollution-source, groundwater-protection,
# air-quality-area, mining-legacy): datasets tagged brownfield/waste/water-quality/air-quality, or with a matching title.
RETAG_CONCEPTS=brownfield,waste,water-quality,air-quality
RETAG_TITLE='contamin|landfill|pollut|radon|source protection|superfund|brownfield|altlast|pollu|hazardous waste|leaking|underground storage|cleanup|clean-up|remediat|air quality management|AQMA|mine ?(?:entr|shaft|waste)|coal mining|abandoned mine'
MAX_DATASETS=20000
RUN=6
