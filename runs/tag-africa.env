# Haiku tagging for Africa (passing datasets, already-tagged skipped). ~8.7k datasets, under $1.
SOURCE=africa
ONLY_PASSING=1
# 24 Nov (second run): re-tag groundwater-protection after narrowing its definition (aquifer geology had got it).
# First run: re-tag after the contamination vocabulary split (contaminated-land, landfill, pollution-source, groundwater-protection,
# air-quality-area, mining-legacy): datasets tagged brownfield/waste/water-quality/air-quality, or with a matching title.
RETAG_CONCEPTS=groundwater-protection
RETAG_TITLE=
MAX_DATASETS=20000
RUN=3
