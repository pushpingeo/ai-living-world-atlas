# The hosted OpenStreetMap copy (.github/workflows/osm.yml; osm/). Edit and push to run.
# MARKET: uk, nl, au or us (osm/spec.json markets). PUBLISH=yes uploads to R2 bucket atlas-data and writes the
# manifest and the atlas record; PUBLISH=no builds and reports only (results/osm).
# 26 Nov 2026: first publish from the atlas (Rob agreed 25 Nov 16:41, go given 26 Nov 06:38). Tobler retired its own
# OSM workflow on 25 Nov, so only this one writes to atlas-data. Set back to PUBLISH=no after that run, so the next
# edit here is a dry build unless someone means otherwise. The weekly runs publish regardless (runs/osm-weekly.env).
# 27 Nov 2026, 06:15: NL dry build retry with the new backoff (Rob's go, 26 Nov). 26 Nov 07:30 got 10 of 12.
# 27 Nov 2026, 16:15: NL first publish (Rob's go, 27 Nov 16:10), after the 12 of 12 dry build that morning. Published 12 of 12,
# release 2026-11-27; set back to PUBLISH=no straight after (pushed with [skip ci], so it didn't start a build).
MARKET=nl
PARQUET=yes
PUBLISH=no
SHARDS=6
MAX_PARALLEL=6
RUN=5
