# Specs the files workflow refreshes on its monthly schedule (3rd of the month). The EA downloads are under a licence
# that lasts one year, so a monthly refresh keeps the copy current and inside the term; NSIP changes daily at source.
SPECS=vocab/files/ea-epr-industrial-sites.yaml vocab/files/ea-epr-waste-sites.yaml vocab/files/ea-pollution-incidents.yaml vocab/files/pins-nsip-england.yaml
